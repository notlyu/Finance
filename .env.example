# Database
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=SwaginHIK228456
DB_NAME=finance_db
DB_PORT=5432
DB_DIALECT=postgres
DATABASE_URL="postgresql://postgres:SwaginHIK228456@localhost:5432/finance_db?schema=public"

# Security
JWT_SECRET=generate_a_secure_random_string_here
NODE_ENV=development

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@example.com

# CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Jobs
ENABLE_RECURRING_JOB=true
ENABLE_INTEREST_JOB=true

# Family
# Максимум участников семьи (В5). По умолчанию 6.
MAX_FAMILY_MEMBERS=6

# Auth
# Секрет для подписи CSRF-токенов (32+ байт). Если не задан — используется JWT_SECRET.
CSRF_SECRET=change_me_to_a_long_random_secret
# Grace-период ротации refresh-токена в мс (анти-разлогин параллельных вкладок). По умолчанию 30000.
REFRESH_GRACE_MS=30000

# Server
PORT=5000
